# ── Required ──
TELEGRAM_BOT_TOKEN=

# ── Access (consumer bot; default = public) ──
ALLOWED_USER_IDS=
# LOCK_BOT_TO_ALLOWLIST=0

# ── Limits ──
# RATE_LIMIT_PER_MINUTE=12
# MAX_PROJECTS_PER_USER=50
# OUTPUT_DIR=/tmp/generated
# PORT=8080

# ── Live run / Telegram API (slow or restricted networks) ──
# TELEGRAM_API_TIMEOUT=30
# TELEGRAM_API_RETRIES=3
# LIVE_RUN_SECONDS=900

# ── Isolation ──
# Prefer Docker when available; local process is allowed by default so
# testing works on Railway/hosts without a Docker daemon.
TBE_PREFER_DOCKER=1
# Security defaults (fail-closed for hosting):
# Docker is required unless ENVIRONMENT=dev/local AND you set TBE_ALLOW_LOCAL_PROCESS=1.
TBE_REQUIRE_DOCKER=1
TBE_ALLOW_LOCAL_PROCESS=0
TBE_MULTI_TENANT=1
# Optional: encrypt bot tokens at rest (defaults to derived platform secret)
# TBE_TOKEN_SECRET=long-random-string
# TBE_DISABLE_TOKEN_FILE=1
# TBE_TOKEN_FILE_ONLY=1
# TBE_DOCKER_MEMORY=192m
# TBE_DOCKER_CPUS=0.4
# TBE_DOCKER_PIDS=48
# Required in multi-tenant: egress-limited network name
# TBE_DOCKER_NETWORK=tbe-egress
# ALLOW_DEV_BILLING=0
# TBE_ALLOW_AUTO_HEAL=0
# TBE_USER_DISK_MB=512

# ── B2B platform ──
# Secure default: API is OFF. Set ENABLE_API=1 only when you intend to expose it.
ENABLE_API=0
# Required outside dev: API key hashing pepper (HMAC). Without it the API refuses to start
# unless ENVIRONMENT=dev|local|test (hardcoded pepper is dev-only and never used in prod).
# API_KEY_PEPPER=another-long-random-pepper-for-api-key-hashes  # REQUIRED in production (>=32 chars); server refuses to boot without it
# PLATFORM_ADMIN_TOKEN=change-me-admin-long-random
# ENVIRONMENT=production
# API_CORS_ORIGIN=https://app.example.com
# Never combine API_CORS_ALLOW_WILDCARD=1 with credentialed frontends.
# API_CORS_ALLOW_WILDCARD=0
# API_PORT=8080
# Redis rate limiting — MANDATORY outside ENVIRONMENT=dev|local|test.
# Production refuses to start without REDIS_URL (no SQLite/memory fallback).
# Dev-only: SQLite/memory allowed when Redis is unset.
# REDIS_URL=redis://127.0.0.1:6379/0


# ── Stripe Billing ──
# PUBLIC_BASE_URL=https://your-domain.com
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_BUSINESS=price_...
# ALLOW_DEV_BILLING=1
# API_CORS_ALLOW_WILDCARD=0

# JOB_MAX_WORKERS=2
# JOB_SYNC_WAIT_SECONDS=300

# ── MongoDB (users + plan only) ──
# MONGODB_URI=mongodb+srv://USER:PASS@cluster0.example.mongodb.net/?appName=Cluster0
# MONGODB_DB=lumen
# Plans: free | pro | unlimited


# ── Hosting foundation (production) ──
# Required for sealing bot tokens at rest (Fernet). Never leave empty in prod.
# TBE_TOKEN_SECRET=long-random-string-at-least-32-chars
# Postgres for multi-node host state (optional; SQLite used if unset)
# TBE_DATABASE_URL=postgresql://user:pass@host:5432/tbe
# DATABASE_URL=postgresql://user:pass@host:5432/tbe
# Object storage for project zips (optional S3/R2/MinIO)
# TBE_S3_BUCKET=my-bucket
# TBE_S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com
# TBE_S3_ACCESS_KEY=
# TBE_S3_SECRET_KEY=
# TBE_S3_REGION=auto
# TBE_S3_PREFIX=projects
# Docker egress network (required in multi-tenant)
# TBE_DOCKER_NETWORK=tbe-egress
# TBE_DOCKER_MEMORY=256m
# TBE_DOCKER_CPUS=0.5
# TBE_DOCKER_PIDS=50

# Image-based hosting (immutable bot images — required for multi-node)
# TBE_DOCKER_REGISTRY=registry.example.com
# TBE_DOCKER_PUSH=1
# TBE_DOCKER_BUILD_TIMEOUT=600
# TBE_NODE_ID=node-1
# TBE_REQUIRE_DATABASE_URL=1


# ── Scale plane (20k hosted bots) ──
# API enqueues; workers on each node run docker build/deploy.
TBE_SCALE_MODE=1
TBE_FORCE_QUEUE=0
TBE_NODE_MAX_BOTS=250
TBE_NODE_MAX_MEMORY_MB=49152
TBE_BOT_MEMORY_MB=192
TBE_WORKER_POLL_SECONDS=2
TBE_MAX_QUEUED_PER_USER=20
# Run on every worker node:
#   python -m lumen.engine.services.hosting.worker
# 20_000 bots ≈ nodes_required = ceil(20000 / bots_per_node)

# ── Market gate (refuse weak commercial hosting) ──
# TBE_MARKET_GATE=1
# Required together for paid hosting:
#   TBE_SCALE_MODE=1
#   TBE_DATABASE_URL=postgresql://...
#   TBE_DOCKER_REGISTRY=...
#   TBE_DOCKER_PUSH=1
#   TBE_DOCKER_NETWORK=tbe-egress
#   TBE_TOKEN_SECRET=(32+ chars)
# TBE_MAX_BOTS_PER_USER=50
# TBE_JOB_STALE_SECONDS=600

# Commercial fleet
# TBE_REGISTRY_USER=
# TBE_REGISTRY_PASSWORD=
# TBE_WORKER_STALE_SECONDS=90
# docs/COMMERCIAL_HOSTING.md

# TBE_ARTIFACT_ROOT=/mnt/tbe-artifacts

# Sentry (optional — strict: disabled when empty)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.05
# TBE_SENTRY_DSN=

# ── Gemini chat + translation ──
# Gemini is disabled unless GEMINI_API_KEY is present or GEMINI_ENABLED=1.
# Keep the key only in Railway secrets/environment variables; never commit it.
# GEMINI_ENABLED=1
# GEMINI_API_KEY=
# GOOGLE_API_KEY=  # alias accepted

# Requested model; change only through environment if Google retires the legacy name.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_TIMEOUT_SEC=45
# Retry one time with the last 4 conversation turns for schema/context-only failures.
# GEMINI_COMPACT_RETRY_ENABLED=1
# During local experiments only, sleep 2 seconds before every Gemini request.
# GEMINI_EXPERIMENT_MODE=1
# Authorized-key failover only; this must not be used to bypass provider quotas.
# GEMINI_KEY_FAILOVER_ENABLED=1
# GEMINI_KEY_COOLDOWN_SEC=60
# Optional additional authorized project keys, tried in deterministic order:
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# ...
# GEMINI_API_KEY_150=
# Bulk: all Gemini keys in ONE variable (comma or newline separated):
# GEMINI_API_KEYS=key_a,key_b,key_c

# ── Groq spec translator (translation only; no external Qwen service) ──
# GROQ_TRANSLATOR_ENABLED=1
# GROQ_API_KEY=
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=
# ... up to GROQ_API_KEY_50 (automatic failover like Gemini keys)
# GROQ_KEY_FAILOVER_ENABLED=1
# GROQ_KEY_COOLDOWN_SEC=60
# GROQ_TRANSLATOR_MODEL=openai/gpt-oss-20b
# GROQ_TRANSLATOR_MODEL_FALLBACKS=openai/gpt-oss-120b,qwen/qwen3.6-27b,allam-2-7b
# GROQ_TRANSLATOR_TIMEOUT_SEC=25
# GROQ_TRANSLATOR_MIN_CONFIDENCE=0.55
# GROQ_TRANSLATOR_MAX_TOKENS=900


# ── Production durability (required outside ENVIRONMENT=dev) ──
# MONGODB_URI=mongodb+srv://...
# REDIS_URL=redis://...
# JOB_BACKEND=redis
# API_IP_RPM=120
# TBE_ALLOW_LOCAL_PROCESS=0
# TBE_REQUIRE_DOCKER=1
# TBE_MULTI_TENANT=1
# TBE_DOCKER_NETWORK=tbe_egress

# ── Experimental: Groq direct code generation (pauses spec_core when ON) ──
# GROQ_CODEGEN_ENABLED=0
# GROQ_ASSIST_OUT_OF_SCOPE=1  # Groq full codegen only when request is outside catalog
# GROQ_CODEGEN_MODEL=openai/gpt-oss-120b
# GROQ_CODEGEN_MODEL_FALLBACKS=qwen/qwen3.6-27b,openai/gpt-oss-20b
# GROQ_CODEGEN_TIMEOUT_SEC=90
# GROQ_CODEGEN_MAX_TOKENS=6000
# Note: Qwen2.5-Coder-32B is NOT available on current Groq free keys.

# ── Tablet / llama.cpp (OpenAI-compatible) ──
# Point Cline agent at Termux llama-server via Cloudflare tunnel
# CLINE_LLM_PROVIDER=llamacpp
# LLAMACPP_BASE_URL=https://YOUR-SUBDOMAIN.trycloudflare.com/v1
# LLAMACPP_MODEL=qwen
# LLAMACPP_MAX_TOKENS=1024
# LLAMACPP_API_KEY=
# CLINE_ENABLED=1
# CLINE_MODE=agent
# CLINE_AGENT_MAX_STEPS=12
# CLINE_LLM_TIMEOUT_SEC=180

# --- Generation engine policy ---
# CLINE_ONLY=0  (default) catalog/hybrid first — recommended
# CLINE_ONLY=1  force free Cline agent (needs live LLM: GROQ/GEMINI/XAI/LLAMACPP)
# CLINE_ENABLED=1 required for agent path
# LLAMACPP_BASE_URL must be a reachable OpenAI-compatible endpoint (dead tunnels → ConnectionError)
# CLINE_NO_CATALOG_FALLBACK=0  allow deterministic fallback if agent LLM fails

# ── Multi-agent verified fallback + durable board ──
# FALLBACK_TEMPLATE_AFTER_ATTEMPTS=2
# MULTI_AGENT_BOARD=layered
# MULTI_AGENT_REDIS_BOARD=1
# MULTI_AGENT_REDIS_PREFIX=lumen:ma:
# MULTI_AGENT_REDIS_TTL_SEC=604800

# ── Multi-agent resume on worker boot ──
# MULTI_AGENT_AUTO_ENQUEUE_RESUME=1
# MULTI_AGENT_RESUME_BOOT_LIMIT=20
# MULTI_AGENT_INLINE_RESUME_ON_BOOT=0

# ── LLM role split (strict by default) ──
# HARD RULE: Groq = chat ONLY | Gemini (Google) = translate ONLY
# No cross-provider failover. Key rotation stays inside each provider pool.
TBE_STRICT_LLM_ROLES=1
TRANSLATE_PROVIDER=gemini
CHAT_PROVIDER=groq
# GROQ_API_KEYS=gsk_a,gsk_b
# GEMINI_API_KEYS=key_a,key_b
# TBE_INFINITE_AUTO=1
# TBE_INFINITE_CORRECT_RETRIES=3

# Infinite atomic engine is the PRIMARY generation path (default ON)
TBE_INFINITE_PRIMARY=1
# TBE_INFINITE_PRIMARY=0  # legacy catalog/hybrid policy

# ── Strong sandbox (generated bots) ──
# TBE_SANDBOX_BACKEND=auto|docker|dind|firecracker
TBE_SANDBOX_BACKEND=auto
# TBE_DOCKER_NETWORK=tbe-egress
# TBE_SANDBOX_CREATE_NETWORK=1
# TBE_DOCKER_SECCOMP=  # defaults to package seccomp-bot.json
# DinD (dedicated daemon — not host docker.sock):
# TBE_DIND_HOST=unix:///var/run/dind/docker.sock
# Firecracker microVM:
# TBE_FIRECRACKER_BIN=/usr/bin/firecracker
# TBE_FC_KERNEL=/path/vmlinux
# TBE_FC_ROOTFS=/path/rootfs.ext4
# TBE_FC_MEM_MIB=256
# TBE_FC_VCPUS=1

# Hardened sandbox (PaaS-grade)
# TBE_SANDBOX_BACKEND=auto|firecracker|gvisor|dind|docker
TBE_PREFER_GVISOR=1
TBE_PREFER_FIRECRACKER=1
TBE_EGRESS_ALLOWLIST=1
TBE_EGRESS_IPTABLES=1
# TBE_EGRESS_ALLOW_HOSTS=api.telegram.org,core.telegram.org
# TBE_DOCKER_RUNTIME=runsc
# TBE_APPARMOR_PROFILE=tbe-bot
# TBE_BOT_MAX_LIFETIME_SEC=0

# Egress (strict = fail closed)
TBE_EGRESS_MODE=strict
TBE_EGRESS_TELEGRAM_ONLY=1
TBE_EGRESS_IPTABLES=1
# TBE_EGRESS_MODE=baseline  # dev only
# Firecracker token path required for FC backend:
# TBE_FC_TAP=tap0
# TBE_FC_TOKEN_IN_BOOTARGS=1
# TBE_FC_ALLOW_NO_NET=0
