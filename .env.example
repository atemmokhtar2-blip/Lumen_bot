# Copy to .env on the host or set in the hosting panel.

TELEGRAM_BOT_TOKEN=

# SpecTranslator — Groq (primary)
GROQ_API_KEY=
GROQ_ENABLED=1
# GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# Chat (SmartChat) + SpecTranslator: set at least one provider
# HF primary for chat when enabled+token; Groq used as fallback
HF_TOKEN=
HF_ENABLED=1
# HF_MODELS=Qwen/Qwen2.5-72B-Instruct,meta-llama/Llama-3.3-70B-Instruct

SPEC_TRANSLATOR=1
SPEC_TRANSLATOR_TIMEOUT=45
LIVE_RUN_SECONDS=900

# Dynamic tool body generation via AI (per command from user text)
DYNAMIC_TOOLS=1
TOOL_EMIT_MAX_TOKENS=1200
