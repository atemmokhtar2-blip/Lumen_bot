# Required — get it from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Optional — comma-separated Telegram user IDs. Empty = allow everyone
# ALLOWED_USER_IDS=123456789,987654321

# Optional — where generated projects are stored
# OUTPUT_DIR=/tmp/generated

# Spec Translator (AI → formal spec only). Default ON.
# SPEC_TRANSLATOR=1
# SPEC_TRANSLATOR_REPAIR=1
# SPEC_TRANSLATOR_TIMEOUT=20
# SPEC_TRANSLATOR_MODEL=gemini-2.0-flash

# Hugging Face Inference Providers (runtime only; never commit the real token)
# HF_TOKEN=hf_your_token_here
# HF_PRIMARY=1
# HF_ENABLED=1
# HF_MODELS=Qwen/Qwen3-4B-Instruct-2507,openai/gpt-oss-120b,meta-llama/Llama-3.1-8B-Instruct
# UNDERSTANDING_AI=1
