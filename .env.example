# Copy to .env on the host or set in the hosting panel (Railway / etc).

# ── Required ──
TELEGRAM_BOT_TOKEN=

# ── Access control (default = PUBLIC for all Telegram users) ──
ALLOWED_USER_IDS=
# LOCK_BOT_TO_ALLOWLIST=0
# ALLOW_ALL_USERS=1

# ── Limits ──
# RATE_LIMIT_PER_MINUTE=12
# MAX_PROJECTS_PER_USER=50
# OUTPUT_DIR=/tmp/generated
# PORT=8080

# ── Strong isolation for generated user bots ──
TBE_PREFER_DOCKER=1
# TBE_DOCKER_IMAGE=python:3.11-slim
# TBE_DOCKER_MEMORY=192m
# TBE_DOCKER_CPUS=0.4
# TBE_DOCKER_PIDS=48
# TBE_DOCKER_USER=65534:65534
