{
  "version": "1.0",
  "bot": {
    "name": "ecommerce_pro_bot",
    "language": "mixed",
    "description": "Pro ecommerce for end-users: catalog, cart, coupons, reviews, digital delivery, Telegram Payments"
  },
  "actors": ["user", "admin"],
  "storage": {
    "type": "sqlite",
    "entities": ["Product", "CartItem", "Order", "Payment", "Coupon", "Review", "WishlistItem"]
  },
  "start_buttons": [
    {"label": "🛒 Shop", "callback_id": "shop.catalog"},
    {"label": "🧺 Cart", "callback_id": "cart.view"},
    {"label": "⭐ Wishlist", "callback_id": "shop.wishlist"},
    {"label": "🌐 Lang", "callback_id": "i18n.lang"}
  ],
  "features": [
    {"id": "start", "feature": "start", "trigger": {"type": "command", "id": "start"}, "action": {"service": "core", "method": "start"}},
    {"id": "help", "feature": "help", "trigger": {"type": "command", "id": "help"}, "action": {"service": "core", "method": "help"}},
    {"id": "shop_catalog", "feature": "shop_catalog", "trigger": {"type": "command", "id": "shop"}, "action": {"service": "shop", "method": "catalog"}},
    {"id": "product_search", "feature": "product_search", "trigger": {"type": "command", "id": "search"}, "action": {"service": "shop", "method": "search"}},
    {"id": "cart_add", "feature": "cart_add", "trigger": {"type": "command", "id": "addcart"}, "action": {"service": "cart", "method": "add"}},
    {"id": "cart_view", "feature": "cart_view", "trigger": {"type": "command", "id": "cart"}, "action": {"service": "cart", "method": "view"}},
    {"id": "cart_checkout", "feature": "cart_checkout", "trigger": {"type": "command", "id": "checkout"}, "action": {"service": "cart", "method": "checkout"}},
    {"id": "coupon_apply", "feature": "coupon_apply", "trigger": {"type": "command", "id": "coupon"}, "action": {"service": "shop", "method": "coupon_apply"}},
    {"id": "wishlist_add", "feature": "wishlist_add", "trigger": {"type": "command", "id": "wish"}, "action": {"service": "shop", "method": "wishlist_add"}},
    {"id": "review_add", "feature": "review_add", "trigger": {"type": "command", "id": "review"}, "action": {"service": "shop", "method": "review_add"}},
    {"id": "shop_my_orders", "feature": "shop_my_orders", "trigger": {"type": "command", "id": "myorders"}, "action": {"service": "shop", "method": "my_orders"}},
    {"id": "shipping_set", "feature": "shipping_set", "trigger": {"type": "command", "id": "shipping"}, "action": {"service": "shop", "method": "shipping_set"}},
    {"id": "shop_add_item", "feature": "shop_add_item", "actor": "admin", "trigger": {"type": "command", "id": "addproduct"}, "action": {"service": "shop", "method": "add_item"}},
    {"id": "stock_set", "feature": "stock_set", "actor": "admin", "trigger": {"type": "command", "id": "stock"}, "action": {"service": "shop", "method": "stock_set"}},
    {"id": "coupon_create", "feature": "coupon_create", "actor": "admin", "trigger": {"type": "command", "id": "newcoupon"}, "action": {"service": "shop", "method": "coupon_create"}},
    {"id": "payment_precheckout", "feature": "payment_precheckout", "trigger": {"type": "message", "id": "pre_checkout"}, "action": {"service": "payments", "method": "pre_checkout"}},
    {"id": "payment_success", "feature": "payment_success", "trigger": {"type": "message", "id": "successful_payment"}, "action": {"service": "payments", "method": "successful_payment"}},
    {"id": "lang", "feature": "lang", "trigger": {"type": "command", "id": "lang"}, "action": {"service": "i18n", "method": "set_language"}},
    {"id": "privacy_policy", "feature": "privacy_policy", "trigger": {"type": "command", "id": "privacy"}, "action": {"service": "compliance", "method": "privacy"}},
    {"id": "terms_of_service", "feature": "terms_of_service", "trigger": {"type": "command", "id": "terms"}, "action": {"service": "compliance", "method": "terms"}}
  ],
  "tech": {
    "database": "sqlite",
    "payments": true,
    "i18n": true
  },
  "hard_constraints": [
    "Checkout creates invoice via Telegram Payments",
    "Stock decremented only after successful_payment",
    "Digital goods delivered only after paid status"
  ]
}
