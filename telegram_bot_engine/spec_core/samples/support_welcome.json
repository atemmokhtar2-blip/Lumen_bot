{
  "version": "1.0",
  "bot": {
    "name": "support_welcome_bot",
    "language": "ar",
    "description": "بوت ترحيب تلقائي وتذاكر دعم"
  },
  "actors": ["user", "admin"],
  "storage": {"type": "sqlite", "entities": ["Ticket"]},
  "start_buttons": [
    {"label": "فتح تذكرة", "callback_id": "ticket.open"},
    {"label": "تذاكري", "callback_id": "ticket.my"}
  ],
  "features": [
    {
      "id": "start",
      "feature": "start",
      "trigger": {"type": "command", "id": "start"},
      "action": {"service": "core", "method": "start"},
      "messages": {"success": "مرحباً — للدعم افتح تذكرة"}
    },
    {
      "id": "help",
      "feature": "help",
      "trigger": {"type": "command", "id": "help"},
      "action": {"service": "core", "method": "help"}
    },
    {
      "id": "welcome_set",
      "feature": "welcome_set",
      "actor": "admin",
      "trigger": {"type": "command", "id": "setwelcome"},
      "action": {"service": "welcome", "method": "set_message"},
      "success": {"message": "تم حفظ رسالة الترحيب"},
      "failure": {"message": "تعذر الحفظ"}
    },
    {
      "id": "welcome_toggle",
      "feature": "welcome_toggle",
      "actor": "admin",
      "trigger": {"type": "command", "id": "welcometoggle"},
      "action": {"service": "welcome", "method": "toggle"}
    },
    {
      "id": "welcome_show",
      "feature": "welcome_show",
      "actor": "admin",
      "trigger": {"type": "command", "id": "welcomeshow"},
      "action": {"service": "welcome", "method": "show"}
    },
    {
      "id": "welcome_test",
      "feature": "welcome_test",
      "actor": "admin",
      "trigger": {"type": "command", "id": "welcometest"},
      "action": {"service": "welcome", "method": "test"}
    },
    {
      "id": "ticket_open",
      "feature": "ticket_open",
      "trigger": {"type": "command", "id": "ticket"},
      "action": {"service": "tickets", "method": "open_ticket"},
      "success": {"message": "تم فتح التذكرة"},
      "failure": {"message": "تعذر فتح التذكرة"}
    },
    {
      "id": "ticket_open_cb",
      "feature": "ticket_open",
      "trigger": {"type": "callback", "id": "ticket.open"},
      "action": {"service": "tickets", "method": "open_ticket"},
      "messages": {"prompt": "اكتب موضوع التذكرة", "success": "تم فتح التذكرة"}
    },
    {
      "id": "ticket_my",
      "feature": "ticket_my",
      "trigger": {"type": "command", "id": "mytickets"},
      "action": {"service": "tickets", "method": "my_tickets"}
    },
    {
      "id": "ticket_my_cb",
      "feature": "ticket_my",
      "trigger": {"type": "callback", "id": "ticket.my"},
      "action": {"service": "tickets", "method": "my_tickets"}
    },
    {
      "id": "ticket_list",
      "feature": "ticket_list",
      "actor": "admin",
      "trigger": {"type": "command", "id": "tickets"},
      "action": {"service": "tickets", "method": "list_tickets"}
    },
    {
      "id": "ticket_reply",
      "feature": "ticket_reply",
      "actor": "admin",
      "trigger": {"type": "command", "id": "replyticket"},
      "action": {"service": "tickets", "method": "reply_ticket"},
      "success": {"message": "تم إرسال الرد"},
      "failure": {"message": "تعذر الرد — الصيغة: /replyticket <id> <نص>"}
    },
    {
      "id": "ticket_close",
      "feature": "ticket_close",
      "trigger": {"type": "command", "id": "closeticket"},
      "action": {"service": "tickets", "method": "close_ticket"},
      "success": {"message": "تم إغلاق التذكرة"},
      "failure": {"message": "تعذر الإغلاق"}
    },
    {
      "id": "ticket_status",
      "feature": "ticket_status",
      "trigger": {"type": "command", "id": "ticketstatus"},
      "action": {"service": "tickets", "method": "ticket_status"},
      "failure": {"message": "تذكرة غير موجودة"}
    }
  ]
}
