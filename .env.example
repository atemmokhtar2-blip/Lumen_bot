# Required — get it from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Optional — comma-separated Telegram user IDs. Empty = allow everyone (insecure for production)
# ALLOWED_USER_IDS=123456789,987654321

# Optional — where generated projects are stored
# OUTPUT_DIR=/tmp/generated

# Spec Translator (AI → formal spec only; never writes code). Default ON.
SPEC_TRANSLATOR=1
SPEC_TRANSLATOR_TIMEOUT=45

# Hugging Face Inference Providers — the ONLY AI path (required for AI translation)
HF_ENABLED=1
# HF_TOKEN=hf_your_token_here
# HF_MODELS=Qwen/Qwen2.5-72B-Instruct,meta-llama/Llama-3.3-70B-Instruct,meta-llama/Llama-3.1-8B-Instruct

# Live run duration for generated/cloned bots (seconds). 900 = 15 minutes.
LIVE_RUN_SECONDS=900
