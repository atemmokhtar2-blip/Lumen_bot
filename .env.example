# Copy to .env on the host or set in the hosting panel.

TELEGRAM_BOT_TOKEN=

# ── AI Providers (order: OpenAI → Hugging Face → Groq) ──
# At least one is required for planning / codegen / chat.

# ChatGPT / OpenAI (preferred for complex plans & codegen)
OPENAI_API_KEY=
OPENAI_ENABLED=1
# OPENAI_MODELS=gpt-4o,gpt-4o-mini
# OPENAI_MODEL=gpt-4o

# Hugging Face (OpenAI-compatible router)
HF_TOKEN=
HF_ENABLED=1
# HF_MODELS=Qwen/Qwen2.5-72B-Instruct,meta-llama/Llama-3.3-70B-Instruct

# Groq (optional fallback)
GROQ_API_KEY=
GROQ_ENABLED=1
# GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# Override provider order (comma-separated): openai,hf,groq
# AI_PROVIDER_ORDER=openai,hf,groq

# Direct plan-driven codegen (1=on)
HF_DIRECT_CODEGEN=1
# PLAN_MAX_TOKENS=10000
# CODEGEN_MAX_TOKENS=16000

SPEC_TRANSLATOR=1
SPEC_TRANSLATOR_TIMEOUT=45
LIVE_RUN_SECONDS=900

# Dynamic tool body generation via AI (per command from user text)
DYNAMIC_TOOLS=1
TOOL_EMIT_MAX_TOKENS=1200
